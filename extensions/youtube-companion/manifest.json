{
  "manifest_version": 3,
  "name": "TouchFish YouTube Companion",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Control only the YouTube windows opened by TouchFish, using your normal browser account.",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{ "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }],
  "externally_connectable": { "matches": ["http://127.0.0.1/*"] },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*" },
  "action": { "default_title": "TouchFish YouTube Companion" }
}
