{
  "name": "touchfish-clock",
  "productName": "摸鱼时钟",
  "desktopName": "com.touchfish.clock.desktop",
  "version": "1.5.2",
  "private": true,
  "description": "A quiet desktop companion for your working day.",
  "author": "TouchFish",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/core.test.ts src/holidays.test.ts src/payroll.test.ts electron/update-policy.test.ts electron/floating-layout.test.ts electron/bilibili-policy.test.ts electron/bilibili-transport.test.ts electron/bilibili-history.test.ts electron/boss-key.test.ts electron/youtube-policy.test.ts",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test:desktop": "npm run build && node scripts/smoke.mjs && node scripts/payroll-smoke.mjs && node scripts/earnings-smoke.mjs",
    "test:floating": "npm run build && node scripts/floating-smoke.mjs",
    "test:holidays": "npm run build && node scripts/holiday-service-smoke.mjs && node scripts/holiday-ui-smoke.mjs",
    "test:bilibili": "npm run build && node scripts/bilibili-service-smoke.mjs && node scripts/bilibili-smoke.mjs",
    "test:bilibili-history": "npm run build && node scripts/bilibili-history-smoke.mjs",
    "test:boss-key": "npm run build && node scripts/boss-key-smoke.mjs",
    "test:youtube": "npm run build && node scripts/youtube-extension-smoke.mjs && node scripts/youtube-bridge-smoke.mjs && node scripts/youtube-ui-smoke.mjs",
    "test:update-proxy": "node scripts/update-proxy-smoke.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "lucide-react": "^0.548.0",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "js-yaml": "4.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "build": {
    "appId": "com.touchfish.clock",
    "productName": "摸鱼时钟",
    "artifactName": "TouchFish-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      { "from": "extensions/youtube-companion", "to": "youtube-companion" }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "摸鱼时钟",
      "artifactName": "TouchFish-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "TouchFish-${version}-win-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "maintainer": "TouchFish"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TedGillXD",
        "repo": "TouchFish",
        "releaseType": "release"
      }
    ]
  }
}
